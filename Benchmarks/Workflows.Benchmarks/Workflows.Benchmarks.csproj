    <ProjectReference Include="..\..\Workflows.Orchestrator\Workflows.Orchestrator.csproj" />
    <ProjectReference Include="..\..\Hosting\Workflows.Hosting.InProcess\Workflows.Hosting.InProcess.csproj" />
    <ProjectReference Include="..\..\DataStore\Workflows.Storage.EntityFrameworkCore\Workflows.Storage.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\DataStore\Workflows.Storage.Postgres\Workflows.Storage.Postgres.csproj" />
  </ItemGroup>

</Project>