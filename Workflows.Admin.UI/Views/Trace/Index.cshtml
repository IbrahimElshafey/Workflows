@model TraceViewModel
@{
    ViewData["Title"] = $"Trace {Model.InstanceId}";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-3 border-bottom">
    <h1 class="h2">Execution Trace</h1>
    <div>
        <a href="/admin/Instances/Detail/@Model.InstanceId" class="btn btn-outline-secondary btn-sm">Back to Instance</a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        Instance <code>@Model.InstanceId</code> — @Model.WorkflowType
    </div>
    <div class="card-body">
        @if (Model.Entries.Any())
        {
            <ul class="timeline">
                @foreach (var entry in Model.Entries)
                {
                    string iconClass = entry.Type switch
                    {
                        "InstanceCreated" => "bi-play-circle text-success",
                        "SignalReceived" => "bi-broadcast text-warning",
                        "CommandDispatched" => "bi-arrow-up-circle text-primary",
                        "CommandCompleted" => entry.IsSuccess ? "bi-check-circle text-success" : "bi-x-circle text-danger",
                        "WaitCreated" => "bi-plus-circle text-info",
                        "WaitCompleted" => entry.IsSuccess ? "bi-check2-circle text-success" : "bi-x-circle text-danger",
                        "Cancellation" => "bi-slash-circle text-danger",
                        _ => "bi-circle text-secondary"
                    };

                    <li class="timeline-item">
                        <div class="timeline-marker">
                            <i class="bi @iconClass fs-5"></i>
                        </div>
                        <div class="timeline-content">
                            <div class="d-flex justify-content-between">
                                <h6 class="mb-1">@entry.Title</h6>
                                <small class="text-muted">@entry.Timestamp.ToString("g")</small>
                            </div>
                            <p class="mb-1">@entry.Description</p>
                            @if (!string.IsNullOrEmpty(entry.PayloadJson))
                            {
                                <details class="small">
                                    <summary>Payload</summary>
                                    <pre class="bg-light p-2"><code>@entry.PayloadJson</code></pre>
                                </details>
                            }
                            @if (!string.IsNullOrEmpty(entry.ResultJson))
                            {
                                <details class="small">
                                    <summary>Result</summary>
                                    <pre class="bg-light p-2"><code>@entry.ResultJson</code></pre>
                                </details>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">No trace entries available.</p>
        }
    </div>
</div>
